    {
      "id": "meta.principal.roles",
      "name": "指定 Agent 角色",
      "category": "主体",
      "description": "仅使用审批上下文实际提供的角色，缺失时为空。",
      "event": "command.approval",
      "parameter": {
        "kind": "strings",
        "placeholder": "basic, guest"
      },
      "predicate": {
        "field": "principal.role",
        "op": "in",
        "value": []
      }
    },
    {
      "id": "meta.principal.agents",
      "name": "指定 Agent 标识",
      "category": "主体",
      "description": "使用审批上下文实际提供的 Agent ID。",
      "event": "command.approval",
      "parameter": {
        "kind": "strings",
        "placeholder": "worker-1"
      },
      "predicate": {
        "field": "principal.agent_id",
        "op": "in",
        "value": []
      }
