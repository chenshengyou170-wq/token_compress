    {
      "id": "meta.analysis.incomplete",
      "name": "命令无法完整静态解析",
      "category": "解析",
      "description": "脚本、动态展开、未支持命令/选项等会命中；可单独设置人工复核。",
      "event": "command.approval",
      "parameter": null,
      "predicate": {
        "field": "command.parse_complete",
        "op": "eq",
        "value": false
      }
    },
    {
      "id": "meta.context.lineage",
      "name": "敏感派生文件外发",
      "category": "会话",
      "description": "复用现有会话检测；单命令试算不含历史状态。",
      "event": "command.approval",
      "parameter": null,
      "predicate": {
        "field": "detector.ids",
        "op": "contains",
        "value": "LING-LINEAGE-030"
      }
    },
    {
      "id": "meta.context.burst",
      "name": "短时间集中外联",
      "category": "会话",
      "description": "复用现有会话检测；单命令试算不含历史状态。",
      "event": "command.approval",
