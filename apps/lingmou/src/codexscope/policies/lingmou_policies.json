      "enforceable_now": true,
      "stateful": false,
      "tested": "real_upstream",
      "match": {
        "min_risk": "critical",
        "contains_any": ["敏感数据可能离开工作区", "支付密钥外泄", "pay-exfil-004"]
      }
    },
    {
      "id": "LING-DESTRUCT-005",
      "name": "高破坏性操作",
      "risk_level": "critical",
      "action": "阻断并要求复核",
      "enabled": true,
      "mode": "deny",
      "stage": "pre_execution_approval",
