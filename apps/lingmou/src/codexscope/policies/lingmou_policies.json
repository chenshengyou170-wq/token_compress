      "enforceable_now": true,
      "stateful": false,
      "tested": "local",
      "match": {
        "min_risk": "warning",
        "contains_any": ["高破坏性命令", "删除文件", "unlink", "mkfs", "shutdown", "reboot"]
      }
    },
    {
      "id": "LING-PRIV-006",
