{
  "schema_version": "lingmou.policy-catalog.v1",
  "policies": [
    {
      "id": "LING-CRED-001",
      "name": "敏感凭证访问",
      "risk_level": "high",
      "action": "记录并告警",
      "enabled": true,
      "match": {
        "min_risk": "notice",
        "contains_any": [".env", "secret", "credential", "凭证", "密钥", "敏感路径", "private_key"]
      }
    },
    {
      "id": "LING-EGRESS-002",
      "name": "异常外部连接",
      "risk_level": "warning",
      "action": "检查出口目标",
      "enabled": true,
      "match": {
        "min_risk": "warning",
        "contains_any": ["connect", "sendto", "sendmsg", "外部网络", "进程访问网络", "https://", "http://"]
      }
    },
    {
      "id": "LING-UPLOAD-003",
      "name": "文件或数据上传",
      "risk_level": "high",
      "action": "进入执行前审批",
      "enabled": true,
      "match": {
        "min_risk": "high",
        "contains_any": ["文件或数据上传", "外部上传通道", "--data", "--upload-file", "scp ", "rsync "]
      }
    },
    {
      "id": "LING-EXFIL-004",
      "name": "敏感数据外泄",
      "risk_level": "critical",
      "action": "阻断并保全证据",
      "enabled": true,
      "mode": "deny",
      "stage": "pre_execution_approval",
